[
  {
    "label": "Run",
    "command": "(kill -9 $(lsof -t -i:3000) 2>/dev/null || true); npx tsc && cargo run",
    "use_new_terminal": false,
    "reveal": "never",
    "reveal_target": "dock",
    "hide": "never",
    "allow_concurrent_runs": true
  },
  {
    "label": "Create new user",
    "command": "cargo run --bin new_users",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "allow_concurrent_runs": true,
  },
]
